# Documented settings only; never put values here. Local values live in .env.local.

# First CMS super admin (owner, 22 Nov). If no super admin exists, the staff account with this
# address is promoted once at startup, or at its first staff sign-in. Never demotes; never creates.
PAYLOAD_BOOTSTRAP_SUPERADMIN_EMAIL=

# Keep unset while shared-event sales are dormant. Allowing two Guest tickets also requires
# the exact product ID below to match the event's published Guest offer.
UNLOCK_SHARED_TICKET_EVENT_ID=
UNLOCK_SHARED_TICKET_GUEST_PRODUCT_ID=

# Off until the Guest lock is attached and qualified. The Commerce Event retains
# eventLock and adds guestLock. List both Polygon event locks, never the Signet.
# Turn off the sale switch to return new sales to eventLock; retain both allowlist
# entries and the CMS guestLock to fulfill previously prepared or paid orders.
UNLOCK_SEPARATE_GUEST_LOCK_ENABLED=
KEY_GRANT_POLYGON_EVENT_LOCKS=

# Optional Unlock EVENTS slug for staff setup; not an admission or sale authority.
UNLOCK_SHARED_TICKET_EVENT_SLUG=
# Seat and guaranteed transport capacity are entered on the CMS Commerce Event, not in env.

# Optional checkout consent only. Off by default; this setting cannot send email or write to Unlock.
UNLOCK_TICKET_EMAIL_CONSENT_ENABLED=
