# Documented settings only; never put values here. Local values live in .env.local.

# First CMS super admin (owner, 22 Nov). If no super admin exists, the staff account with this
# address is promoted once at startup, or at its first staff sign-in. Never demotes; never creates.
PAYLOAD_BOOTSTRAP_SUPERADMIN_EMAIL=

# Keep unset while shared-event sales are dormant. Allowing two Guest tickets also requires
# the exact product ID below to match the event's published Guest offer.
UNLOCK_SHARED_TICKET_EVENT_ID=
UNLOCK_SHARED_TICKET_GUEST_PRODUCT_ID=
