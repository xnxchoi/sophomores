# Delivers the key-grant alert spool by email (scripts/key-grant-alert.ts deliver; owner, 25 Nov: "email alerts via
# Zoho is fine"). uid 2002 with the alerts group 2001, sophomores-review-egress only (never the fenced key-job bridge),
# no signer, RPC or DB. Its settings come from KJ/mail/alert-mail.env (2002:2002 0400), loaded in-process with
# node --env-file, never docker --env-file. Not chain-capable, so a fence alert is still delivered while fenced.
[Unit]
Description=Sophomores key-grant alert mail (one delivery pass)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RuntimeDirectory=key-grant/mail
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/sbin/kj-guard run mail
ExecStopPost=/usr/local/sbin/kj-guard reap mail
TimeoutStartSec=120
NoNewPrivileges=yes
