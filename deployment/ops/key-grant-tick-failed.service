# OnFailure of the tick units: spools {"kind":"tick_failure","reason":"systemd_failed"} for the mailer. Same image,
# no network, the spool only (built by kj-guard). Not chain-capable, so it still runs while the key job is fenced.
[Unit]
Description=Spool an alert for a failed or timed-out key-grant run
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RuntimeDirectory=key-grant/failed
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/sbin/kj-guard run failed
ExecStopPost=/usr/local/sbin/kj-guard reap failed
TimeoutStartSec=60
NoNewPrivileges=yes
