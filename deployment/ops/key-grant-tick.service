# Polygon key-grant tick, one run (deployment/KEY-GRANTS.md). Template: replace <runner>, <release>, <grant env files>.
# The RPC URL and the signer key are NOT here: the tick reads ~<runner>/.config/sphmrs/polygon-rpc.env and
# polygon-key-granter.env itself (0600, owned by <runner>) and refuses if KEY_GRANT_POLYGON_RPC_URL is in its env.
# Alerts go to the durable spool, which key-grant-alert-mail delivers as another user; nothing reads the journal.
[Unit]
Description=Sophomores Polygon key-grant tick (one run)
After=network-online.target
Wants=network-online.target
# A failed or timed-out run is an alert too.
OnFailure=key-grant-tick-failed.service

[Service]
Type=oneshot
User=<runner>
WorkingDirectory=<release>
EnvironmentFile=<grant env files: database, KEY_GRANT_POLYGON_MAX_COST_WEI, KEY_GRANT_POLYGON_EVENT_LOCKS, KEY_GRANT_POLYGON_LIVE>
Environment=KEY_GRANT_ALERT_SPOOL=/var/lib/sophomores-key-grant-alerts/spool
ExecStart=/usr/bin/env node --import tsx scripts/key-grant-tick.ts
# Reconcile starts no row after 6 min and each walk gives up after 2 min, so a run ends well inside this
# (grant-catch-up.ts RECONCILE_BUDGET_MS, transactions.ts WALK_BUDGET_MS). The timer never starts a second run meanwhile.
TimeoutStartSec=900
UMask=0007
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/sophomores-key-grant-alerts/spool
