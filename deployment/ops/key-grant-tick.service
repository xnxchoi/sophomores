# Polygon key-grant tick, one run (deployment/KEY-GRANTS.md; VPS plans v3-v6). Everything goes through the host guard
# (kj-guard.sh, installed as /usr/local/sbin/kj-guard): admission under its lock (refused while any fence generation
# exists), a labelled `docker create` with a per-invocation CID record, a re-check, then `docker start -a`; ExecStopPost
# removes this invocation's container and proves it absent, or fences. Scheduled mode: its LIVE comes only from
# KJ/config/scheduled.env (written at K6g, its own owner go), never from the first-run permit. The container command,
# mounts and limits are built by the guard from KJ/config/guard.conf (root 0600, no secrets).
[Unit]
Description=Sophomores Polygon key-grant tick (one run)
After=network-online.target docker.service key-grant-fence-restore.service
Wants=network-online.target
Requires=docker.service
# A failed or timed-out run is an alert too.
OnFailure=key-grant-tick-failed.service

[Service]
Type=oneshot
RuntimeDirectory=key-grant/tick
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/sbin/kj-guard run tick
ExecStopPost=/usr/local/sbin/kj-guard reap tick
# 900 s is systemd's HARD STOP: it kills the docker client (reported via OnFailure as systemd_failed); the reap above
# then removes the container or fences. Graceful completion is in the code (grant-catch-up.ts TICK_BUDGET_MS).
TimeoutStartSec=900
TimeoutStopSec=120
NoNewPrivileges=yes
