# Generate the ignored mode-0600 file using the receive command's prepare operation.
# These values belong ONLY to the standalone receiver, never Next or NEXT_PUBLIC_*.
# Use matching datacenter hosts; .com below is an example, not a detected region.
PHONE_VERIFICATION_ZOHO_MAIL_ORIGIN=https://mail.zoho.com
PHONE_VERIFICATION_ZOHO_ACCOUNTS_ORIGIN=https://accounts.zoho.com
PHONE_VERIFICATION_ZOHO_CLIENT_ID=REPLACE_CLIENT_ID
PHONE_VERIFICATION_ZOHO_CLIENT_SECRET=REPLACE_CLIENT_SECRET
PHONE_VERIFICATION_ZOHO_AUTHORIZATION_CODE=REPLACE_AUTHORIZATION_CODE
# authorize replaces the one-use code with a privately saved refresh token.
