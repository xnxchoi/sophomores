  "parser_constants": {
    "korean": {
      "e164_prefix": "+82",
      "local_prefix": "010",
      "standard_phone_length": 11,
      "general_from_regex": "^(010[0-9]{8})@([a-z0-9.-]+)$"
    },
    "us": {
      "e164_prefix": "+1",
      "standard_phone_length": 10,
      "general_from_regex": "^([2-9][0-9]{9})@([a-z0-9.-]+)$"
    },
    "otp_token_format": "^SPHMRS ([A-Za-z0-9_-]{43})$"
  },
