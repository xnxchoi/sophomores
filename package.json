{
  "name": "sophomores-co",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "ci": "pnpm migrate && pnpm build",
    "dev": "docker desktop start && docker start postgres && wait-on tcp:4141 && cross-env PREVIEW_AUTH_MODE=public NODE_OPTIONS=--no-deprecation next dev --hostname 127.0.0.1",
    "start": "next start",
    "lint": "eslint",
    "dev:init": "pnpm micreate",
    "test": "node tests/run-unit.mjs",
    "typecheck": "tsc --noEmit",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx ./node_modules/payload/bin.js --disable-transpile generate:types",
    "generate:schema": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx ./node_modules/payload/bin.js --disable-transpile generate:db-schema",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx ./node_modules/payload/bin.js --disable-transpile generate:importmap",
    "micreate": "PAYLOAD_CONFIG_PATH=./payload.config.ts node --import tsx ./node_modules/payload/bin.js --disable-transpile migrate:create",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=./payload.config.ts node --import tsx ./node_modules/payload/bin.js --disable-transpile migrate",
    "migrate:fresh": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=./payload.config.ts node --import tsx ./node_modules/payload/bin.js --disable-transpile migrate:fresh",
    "deploy": "node --import tsx scripts/deploy.ts",
    "copy:sync": "node --import tsx scripts/sync-copy.ts",
    "phone-verification:preview": "node --import tsx scripts/phone-verification-preview.ts",
    "test:preview-runtime": "node --import tsx --test tests/runtime/preview-auth.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/core": "1.7.12",
    "@better-auth/passkey": "1.7.12",
    "@better-auth/utils": "0.5.0",
    "@payloadcms/db-postgres": "^3.92.0",
