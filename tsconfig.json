{
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022", "ES2023"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@payload-config": ["./payload.config.ts"],
      "@payload-types": ["./lib/payload/payload-types.ts"]
    },
    "target": "ES2022"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "**/*.mts",
    ".next/dev/types/**/*.ts"
  ],

  "exclude": [
    ".deployment/**",
    "node_modules",
    "src/providers/**",
    "src/utilities/**",
    "src/payload/**",
    "src/components/UX/**",
    "src/components/core/**",
    "src/components/Shells/**",
    "src/components/content/**",
    "src/components/three/**",
    "src/components/forms/**",
    "src/components/identity/**",
    "src/components/layouts/**",
    "src/components/ui/HA_*",
    "src/components/sections/BOTD/**",
    "src/components/sections/Credits/**",
    "src/components/sections/DayNNight/**",
    "src/components/sections/DayNNightGate/**",
    "src/components/sections/FeaturedHero/**",
    "src/components/sections/HeadlinersRail/**",
    "src/components/sections/Justification/**",
    "src/components/sections/ParallaxGrid/**",
    "src/components/sections/PriceCard/**",
    "src/components/sections/Pricing/**",
    "src/components/sections/Showcase/**",
    "src/components/sections/Starliner/**",
    "src/components/sections/StationHideaway/**",
    "src/components/sections/split-section/**",
    "src/components/auth/AuthCard.tsx",
    "src/components/auth/AuthCard.test.tsx",
    "src/components/auth/AuthShell.tsx",
    "src/components/auth/AuthShell.prerender.test.ts",
    "src/components/auth/AuthTextLink.tsx",
    "src/components/auth/ForgotPasswordForm.tsx",
    "src/components/auth/PasskeyButton.tsx",
    "src/components/auth/PasswordInput.tsx",
    "src/components/auth/ProviderButton.tsx",
    "src/components/auth/ProviderButton.test.tsx",
    "src/components/auth/ResetPasswordForm.tsx",
    "src/components/auth/SignInForm.tsx",
    "src/components/auth/SignUpForm.tsx",
    "src/components/auth/SignedIn.tsx",
    "src/components/auth/TwoFactorCard.tsx",
    "src/components/auth/UserAvatar.tsx",
    "src/components/auth/auth-styles.ts",
    "src/components/auth/icons.tsx",
    "src/components/auth/index.ts"
  ]
}
